<Project Sdk="Microsoft.NET.Sdk">

  <!-- The PVControl plugin (src/PVControl); DataLogger too: PVControl reads its DB (schema, file name), its tests build that DB. -->
  <Import Project="..\Tests.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\src\PVControl\PVControl.csproj" />
    <ProjectReference Include="..\..\src\DataLogger\DataLogger.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The planner tests' helpers and live snapshots (one copy, used by both test projects). -->
  <ItemGroup>
    <Compile Include="..\Planning.Tests\TestBase.cs" Link="TestBase.Planning.cs" />
    <None Include="..\Planning.Tests\Data\forecast_snapshot_*.json.gz" Link="Data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
