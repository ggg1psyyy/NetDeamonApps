<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline backtest of load forecast models against a copy of DataLogger's energy_history.db.
       Not part of the deployed app (not in the solution).
       Run: see README.md in this folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- The production load model (PVControl's LoadModel, pure, no HA dependency) with the shared calculations
       (Common, through PVControl), backtested as variant "App". -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\PVControl\PVControl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.ML" />
    <PackageReference Include="Microsoft.ML.FastTree" />
  </ItemGroup>

</Project>
