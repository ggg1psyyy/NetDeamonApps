<?xml version="1.0" encoding="utf-8"?>
<!-- Every package of this repository comes from nuget.org (package source mapping, required with
     central package management when more than one source is configured on the machine). -->
<configuration>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
