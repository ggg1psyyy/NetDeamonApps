<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>NetDeamon</RootNamespace>
    </PropertyGroup>
  
    <ItemGroup>
        <None Update="$(MSBuildProjectDir)appsettings.Development.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        </None>        
        <None Update="$(MSBuildProjectDir)appsettings.json">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
        <None Update="$(MSBuildProjectDir)apps\**\*.yaml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <Compile Remove="NetDeamonApps.Tests\**" />
        <None Remove="NetDeamonApps.Tests\**" />
        <Content Remove="NetDeamonApps.Tests\**" />
        <EmbeddedResource Remove="NetDeamonApps.Tests\**" />
        <Compile Remove="HA\**" />
        <None Remove="HA\**" />
        <Compile Remove="tools\**" />
        <Compile Remove="src\**" />
        <None Remove="src\**" />
        <Content Remove="src\**" />
        <EmbeddedResource Remove="src\**" />
        <None Remove="tools\**" />
        <Content Remove="tools\**" />
        <EmbeddedResource Remove="tools\**" />
    </ItemGroup>

    <Target Name="AfterPublishMessage" AfterTargets="Publish">
        <Message Text="Publish done! Copy all content in directory: $(PublishDir) to the `/config/netdaemon6' folder for add-on or your custom folder to deploy." Importance="high" />
    </Target>
        
    <ItemGroup>
        <ProjectReference Include="src\Common\Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="linq2db.SQLite.MS" />
        <PackageReference Include="Microsoft.Data.Sqlite" />
        <PackageReference Include="NetDaemon.AppModel" />
        <PackageReference Include="NetDaemon.Extensions.Mqtt" />
        <PackageReference Include="NetDaemon.Runtime" />
        <PackageReference Include="NetDaemon.HassModel" />
        <PackageReference Include="NetDaemon.Client" />
        <PackageReference Include="NetDaemon.Extensions.Scheduling" />
        <PackageReference Include="NetDaemon.Extensions.Logging" />
        <PackageReference Include="NetDaemon.Extensions.Tts" />
        <PackageReference Include="SixLabors.ImageSharp.Drawing" />
    </ItemGroup>
        
    <ItemGroup>
      <EmbeddedResource Remove="HA\**" />
    </ItemGroup>
</Project>
