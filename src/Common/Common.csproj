<Project Sdk="Microsoft.NET.Sdk">

  <!-- Code shared by the NetDaemon host and the app plugins: the basic calculations (Calculations.cs),
       generic Home Assistant helpers (Extensions.cs), the apps' SQLite schema helper, the build
       version and the import counters in priority order (PVControl and DataLogger). -->
  <PropertyGroup>
    <AssemblyName>NetDeamonApps.Common</AssemblyName>
    <RootNamespace>NetDeamon</RootNamespace>
  </PropertyGroup>

  <!-- Private: Common's packages don't flow on to who references it. The host ships them (its own references),
       plugins compile against them without copying them, so each lies only once in the deployed folder. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" PrivateAssets="all" />
    <PackageReference Include="NetDaemon.Client" PrivateAssets="all" />
    <PackageReference Include="NetDaemon.HassModel" PrivateAssets="all" />
  </ItemGroup>

</Project>
