<Project Sdk="Microsoft.NET.Sdk">

    <!-- The host (shim): starts NetDaemon and loads the app plugins (PluginLoader). The HA add-on starts
         NetDeamonApps.dll, so the assembly keeps that name. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>NetDeamonApps</AssemblyName>
        <RootNamespace>NetDeamon</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <None Update="appsettings.Development.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        </None>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- App plugins, published with the host into apps/plugins/<Name>/ (PluginLoader). The host doesn't
         reference them: they're loaded at run time. -->
    <ItemGroup>
        <AppPlugin Include="..\HeatingTest\HeatingTest.csproj" />
        <AppPlugin Include="..\DataLogger\DataLogger.csproj" />
        <AppPlugin Include="..\PVControl\PVControl.csproj" />
        <AppPlugin Include="..\MidiControl\MidiControl.csproj" />
    </ItemGroup>
    <Target Name="PublishAppPlugins" AfterTargets="Publish">
        <MSBuild Projects="@(AppPlugin)" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)', '$(MSBuildProjectDirectory)'))apps\plugins\%(AppPlugin.Filename)\" />
    </Target>
    <Target Name="AfterPublishMessage" AfterTargets="Publish">
        <Message Text="Publish done! Copy all content in directory: $(PublishDir) to the `/config/netdaemon6' folder for add-on or your custom folder to deploy." Importance="high" />
    </Target>

    <ItemGroup>
        <ProjectReference Include="..\Common\Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="NetDaemon.AppModel" />
        <PackageReference Include="NetDaemon.Extensions.Mqtt" />
        <PackageReference Include="NetDaemon.Runtime" />
        <PackageReference Include="NetDaemon.HassModel" />
        <PackageReference Include="NetDaemon.Client" />
        <PackageReference Include="NetDaemon.Extensions.Scheduling" />
        <PackageReference Include="NetDaemon.Extensions.Logging" />
        <PackageReference Include="NetDaemon.Extensions.Tts" />
    </ItemGroup>
</Project>
