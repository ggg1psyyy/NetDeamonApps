<Project>
  <!-- Version from git for every project (see src/Common/AppVersion.cs):
       0.5.<commit count>+<short hash>[.dirty]; the same in every assembly of one build. -->
  <PropertyGroup>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <Target Name="GitVersion" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitCount" />
    </Exec>
    <Exec Command="git rev-parse --short=7 HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitHash" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=no" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitChanges" />
    </Exec>
    <PropertyGroup Condition="'$(GitHash)' != ''">
      <GitDirty Condition="'$(GitChanges)' != ''">.dirty</GitDirty>
      <Version>0.5.$(GitCommitCount)</Version>
      <InformationalVersion>0.5.$(GitCommitCount)+$(GitHash)$(GitDirty)</InformationalVersion>
    </PropertyGroup>
  </Target>
</Project>
